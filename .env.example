# development | production (production enables safety checks and hides /api/docs)
ENV=development

# Copy to .env and fill in. Never commit .env.

# New backend. Defaults to a local SQLite file if unset.
# For Postgres/Neon: postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Groups with fewer respondents than this are hidden from HR/admin views
MIN_GROUP_SIZE=5

# Only used by legacy/api (old Flask app)
LEGACY_DATABASE_URL=

# Signs login sessions. Long random string; never share or commit.
SECRET_KEY=
# true when served over HTTPS
COOKIE_SECURE=false

# Ask for the 6-digit email code at signup. Set to true once email sending works.
REQUIRE_EMAIL_VERIFICATION=true

# ── Email ──────────────────────────────────────────────────────
# console = save emails to backend/outbox/ (development). smtp = send for real.
EMAIL_BACKEND=console
EMAIL_FROM=BurnoutAI <no-reply@yourdomain.com>
# Any SMTP provider works. Examples:
#   Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465 SMTP_SECURITY=ssl SMTP_USER=resend SMTP_PASSWORD=re_xxx
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURITY=starttls SMTP_USER=<login> SMTP_PASSWORD=<smtp key>
#   Gmail:    SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURITY=starttls SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Public URLs used in email links
APP_URL=http://localhost:5173
# Hour (in each user's timezone) after which the daily reminder can go out
REMINDER_HOUR=9
